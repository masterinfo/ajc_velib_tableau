              <calculation class='tableau' formula='CASE [Parameters].[Parameter 16875086050144256]&#13;&#10;  WHEN &quot;Mécaniques&quot;  THEN [mechanical]&#13;&#10;  WHEN &quot;Electriques&quot; THEN [ebike]&#13;&#10;  ELSE [numbikesavailable]&#13;&#10;END' />
            </column>
            <column-instance column='[Calculation_14005635455635459]' derivation='Attribute' name='[attr:Calculation_14005635455635459:nk]' pivot='key' type='nominal' />
