      <aliases enabled='yes' />
      <column caption='taux_remplissage' datatype='real' default-format='p0.00%' name='[Calculation_14005635454111744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([numbikesavailable]) / SUM([capacity])/100' />
      </column>
      <column caption='percent_ebike' datatype='real' name='[Calculation_14005635454423041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(SUM([numbikesavailable]) = 0, NULL, SUM([ebike]) / SUM([numbikesavailable]))' />
      </column>
      <column caption='seulementParis' datatype='string' name='[Calculation_14005635454992386]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [nom_arrondissement_communes] = &quot;Paris&quot; THEN &quot;Paris&quot; ELSE &quot;Hors Paris&quot; END' />
      </column>
      <column caption='StatutStation' datatype='string' name='[Calculation_14005635455635459]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_installed] = &quot;NON&quot; OR [is_renting] = &quot;NON&quot; THEN &quot;Hors service&quot;&#13;&#10;ELSEIF [numbikesavailable] = 0      THEN &quot;Vide&quot;&#13;&#10;ELSEIF [numdocksavailable] = 0    THEN &quot;Pleine&quot;&#13;&#10;ELSEIF [numbikesavailable] &lt;= 2     THEN &quot;Presque vide&quot;&#13;&#10;ELSE &quot;Disponible&quot; END' />
      </column>
      <column caption='Point_Station' datatype='spatial' name='[Calculation_14005635466780684]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKEPOINT([lat], [lon])' />
      </column>
      <column caption='Point_Choisi' datatype='spatial' name='[Calculation_14005635467018254]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKEPOINT([Parameters].[Parameter 14005635465347076], [Parameters].[Parameter 14005635465588741])' />
      </column>
      <column caption='Distance (km) ' datatype='real' name='[Calculation_14005635467427856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DISTANCE([Calculation_14005635466780684], [Calculation_14005635467018254], &apos;km&apos;)' />
      </column>
      <column caption='Cercle' datatype='spatial' name='[Calculation_14005635467837457]' role='measure' type='nominal'>
        <calculation class='tableau' formula='BUFFER([Calculation_14005635467018254], [Parameters].[Parameter 14005635465744390], &apos;km&apos;)' />
      </column>
      <column caption='Dans le rayon' datatype='boolean' name='[Calculation_14005635468124178]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_14005635467427856] &lt;= [Parameters].[Parameter 14005635465744390]' />
      </column>
      <column caption='K3 = nombre de vélos électriques disponibles / nombre total de vélos disponibles.' datatype='real' name='[Calculation_16799769441820672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ebike]) / SUM([numbikesavailable])' />
      </column>
      <column caption='Velos séléctionnés' datatype='integer' name='[Calculation_16875086050705409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 16875086050144256]&#13;&#10;  WHEN &quot;Mécaniques&quot;  THEN [mechanical]&#13;&#10;  WHEN &quot;Electriques&quot; THEN [ebike]&#13;&#10;  ELSE [numbikesavailable]&#13;&#10;END' />
      </column>
      <column caption='Taux commune ' datatype='real' name='[Calculation_16875086057086981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [nom_arrondissement_communes] : SUM([numbikesavailable]) / SUM([capacity]) }' />
      </column>
      <column caption='Écart station' datatype='real' name='[Calculation_16875086057779206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([numbikesavailable]) / SUM([capacity])&#13;&#10;- MIN({ FIXED [nom_arrondissement_communes] : SUM([numbikesavailable]) / SUM([capacity]) })' />
      </column>
      <column caption='Part cumulée' datatype='real' name='[Calculation_16875086062051336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([capacity])) / TOTAL(SUM([capacity]))'>
          <table-calc ordering-type='Rows' />
